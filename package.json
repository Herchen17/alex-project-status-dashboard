{
  "name": "bitclaw-protocol",
  "version": "1.0.0",
  "description": "The Bitcoin of AI Agent Platforms",
  "main": "index.js",
  "scripts": {
    "compile": "tsc",
    "compile:blockchain": "hardhat compile",
    "deploy": "hardhat run scripts/deploy_bitclaw.js --network base",
    "verify": "hardhat verify --network base",
    "test": "node --test test/**/*.test.js",
    "test:blockchain": "hardhat test",
    "build": "npm run compile",
    "clean": "rm -rf dist"
  },
  "keywords": [
