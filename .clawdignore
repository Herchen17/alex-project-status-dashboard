# Exclude binary files from workspace processing
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.pdf
*.mp4
*.mov
*.avi
*.zip
*.tar.gz
*.exe
*.dll
*.so
*.dylib

# Large files that shouldn't be processed as text
antfarm/assets/dashboard-*.png
antfarm/landing/dashboard-*.png
antfarm/landing/og-image.png

# Node modules (already excluded but being explicit)
node_modules/

# Log files
*.log

# Cache directories
cache/
.cache/